# Local development database (Docker Compose)
DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban_dev?schema=public"
DIRECT_URL="postgresql://kanban:kanban@localhost:5433/kanban_dev?schema=public"

# Integration test database (created by docker/init)
TEST_DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban_test?schema=public"

# Generate a long random value for production. Must be >= 32 characters.
JWT_SECRET="dev-only-secret-change-me-please-32-chars"

PORT=4000
# Comma-separated URLs are accepted. Loopback ports are allowed for local work.
CLIENT_ORIGIN="http://localhost:5173"
# Public origin used by the OAuth metadata and the remote /mcp endpoint. In production
# it defaults to the first CLIENT_ORIGIN; set it when the app has a different public origin.
# PUBLIC_URL="https://your-app.example"
NODE_ENV="development"

# Neon: run `neon deploy` at the repo root. It writes DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct) to ../../.env.local. The API and the Prisma
# scripts load that file before this one, and map DATABASE_URL_UNPOOLED to
# DIRECT_URL, so the Neon values win over the Docker defaults above.
# You do not need to duplicate the Neon connection strings here.
