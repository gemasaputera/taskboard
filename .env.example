# Repo-root environment for Neon (optional).
#
# Copy to `.env.local` and fill in your own values, or let `neon deploy` write it:
#   cp .env.example .env.local
#
# The API loads this file *before* apps/api/.env, so the values here win.
# `DATABASE_URL_UNPOOLED` is mapped to `DIRECT_URL` for Prisma migrations.
# Never commit `.env.local` — it is gitignored.

# Pooled connection (used by the API at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection (used by the Prisma CLI for migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require"

# Optional: label for the Neon branch you are pointed at
NEON_BRANCH=production
